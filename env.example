# ─────────────────────────────────────────────────────────────────────────────
# SSV Manager – Cloud Functions – Variabili d'ambiente
# Copia questo file in .env e compila i valori prima del deploy.
# Per valori sensibili (es. SMTP_PASS) usa Firebase Secret Manager:
#   firebase functions:secrets:set SMTP_PASS
# ─────────────────────────────────────────────────────────────────────────────

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Host del server SMTP (es. smtp.gmail.com, smtp.sendgrid.net, smtp-relay.brevo.com)
SMTP_HOST=smtp.example.com

# Porta SMTP (587 per STARTTLS, 465 per SSL, 25 non raccomandato)
SMTP_PORT=587

# true = connessione SSL diretta (porta 465), false = STARTTLS (porta 587)
SMTP_SECURE=false

# Credenziali SMTP
SMTP_USER=notifiche@example.com
SMTP_PASS=your-smtp-password

# Indirizzo mittente visualizzato nel client email
SMTP_FROM=SSV Manager <notifiche@example.com>

# ── CONFIGURAZIONE DESTINATARI ────────────────────────────────────────────────
# I destinatari NON si configurano qui ma direttamente su Firestore:
#
#   Collezione : config
#   Documento  : emailNotifications
#   Campi      :
#     enabled    : true | false   → abilita/disabilita tutte le notifiche
#     recipients : ["email1@example.com", "email2@example.com"]
#
# In questo modo i destinatari possono essere aggiornati senza rideploy.
